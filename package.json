{
  "name": "@wzha0190/openchamber-server-browser-agentic",
  "version": "0.10.1-agentic.1",
  "private": true,
  "description": "Agentic fork of Server Browser for OpenChamber",
  "type": "module",
  "license": "MIT",
  "repository": "github:wzha0190/openchamber-server-browser-agentic",
  "engines": {
    "node": ">=22"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.1"
    },
    "contributes": {
      "panel": {
        "id": "server-browser",
        "name": "Server Browser Agentic (Fork)",
        "icon": "computer",
        "entry": "panel/index.html",
        "dock": "top",
        "size": 76,
        "mobile": true
      },
      "page": {
        "entry": "panel/inspector.html",
        "title": "Browser inspector",
        "mobile": true
      },
      "statusSection": {
        "entry": "panel/status.html",
        "source": {
          "path": "/status",
          "interval": 5000
        },
        "height": 28
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "provides": [
          "browser"
        ],
        "surface": true,
        "keepRunning": true,
        "permissions": {
          "exec": [
            "chromium",
            "google-chrome",
            "lsof",
            "ps",
            "top"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "start": "node service/main.js",
    "check": "node --check service/main.js",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@openchamber/sdk": "2.6.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "esbuild": "0.28.0"
  }
}
